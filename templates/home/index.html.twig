{% extends 'base.html.twig' %}

{% block title %}
	{{ parent() }}
	- Restaurant gastronomique à Paris
{% endblock %}

{% block body %}

	{% include 'home/__hero.html.twig' %}

	<section class="container-prose py-12 grid md:grid-cols-2 gap-16 items-center">
		<div>
			<span class="divider-gold mb-6">Notre maison</span>
			<h2 class="font-serif text-4xl md:text-5xl leading-tight">
				Une cuisine sincère,<br/>portée par la saison.
			</h2>
			<p class="mt-6 text-muted-foreground leading-relaxed">
				Chez Boca, chaque assiette raconte une histoire — celle d'un producteur, d'un terroir, d'un geste précis transmis de génération en génération. Notre chef compose une carte courte, vivante, qui suit le rythme des marchés.
			</p>
			<a href="{{ path('about') }}" class="inline-block mt-8 text-xs uppercase tracking-[0.25em] text-gold border-b border-gold pb-1">
				Notre histoire
			</a>
		</div>
		<div class="grid grid-cols-2 gap-4">
			<img src="{{ asset('images/dish-1.jpg') }}" alt="Saint-Jacques poêlées" loading="lazy" class="aspect-[3/4] object-cover shadow-elegant"/>
			<img src="{{ asset('images/dish-2.jpg') }}" alt="Filet de bœuf, sauce vin rouge" loading="lazy" class="aspect-[3/4] object-cover mt-12 shadow-elegant"/>
		</div>
	</section>

	<section class="bg-card/40 py-28 border-y border-border">
		<div class="container-prose text-center">
			<span class="divider-gold mb-6">Nos spécialités</span>
			<h2 class="font-serif text-4xl md:text-5xl">Quelques signatures</h2>
			<div class="mt-16 grid md:grid-cols-3 gap-10">
				<article class="group">
					<div class="overflow-hidden">
						<img src="{{ asset('images/dish-1.jpg') }}" alt="Saint-Jacques de Bretagne" loading="lazy" class="aspect-square object-cover transition-transform duration-700 group-hover:scale-105"/>
					</div>
					<h3 class="mt-6 font-serif text-2xl">Saint-Jacques de Bretagne</h3>
					<p class="mt-2 text-sm text-muted-foreground italic">Truffe noire, beurre noisette</p>
				</article>
				<article class="group">
					<div class="overflow-hidden">
						<img src="{{ asset('images/dish-2.jpg') }}" alt="Filet de bœuf maturé" loading="lazy" class="aspect-square object-cover transition-transform duration-700 group-hover:scale-105"/>
					</div>
					<h3 class="mt-6 font-serif text-2xl">Filet de bœuf maturé</h3>
					<p class="mt-2 text-sm text-muted-foreground italic">Réduction au pinot noir</p>
				</article>
				<article class="group">
					<div class="overflow-hidden">
						<img src="{{ asset('images/dish-3.jpg') }}" alt="Fruits rouges & or" loading="lazy" class="aspect-square object-cover transition-transform duration-700 group-hover:scale-105"/>
					</div>
					<h3 class="mt-6 font-serif text-2xl">Fruits rouges & or</h3>
					<p class="mt-2 text-sm text-muted-foreground italic">Sablé breton, sorbet maison</p>
				</article>
			</div>
		</div>
	</section>

	<section class="container-prose py-28 text-center">
		<h2 class="font-serif text-4xl md:text-6xl max-w-3xl mx-auto leading-tight">
			Réservez votre
			<em class="text-gold font-normal">moment</em>.
		</h2>
		<p class="mt-6 max-w-lg mx-auto text-muted-foreground">
			Tables limitées chaque soir. Confirmation immédiate.
		</p>
		<a href="{{ path('reservation') }}" class="inline-block mt-10 px-10 py-4 text-xs tracking-[0.25em] uppercase bg-gold text-gold-foreground hover:shadow-glow transition-shadow">
			Réserver maintenant
		</a>
	</section>
{% endblock %}
