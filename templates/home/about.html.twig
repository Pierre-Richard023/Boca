{% extends "base.html.twig" %}
{% block title %}
	{{ parent() }}
	- À propos
{% endblock %}

{% block body %}
	<section class="container-prose py-8 md:py-12 grid md:grid-cols-2 gap-16 items-center">
		<div>
			<span class="divider-gold mb-6">Notre histoire</span>
			<h1 class="font-serif text-5xl md:text-6xl leading-tight">
				Trente-cinq ans de
				<em class="text-gold font-normal">passion</em>.
			</h1>
			<div class="mt-8 space-y-5 text-muted-foreground leading-relaxed">
				<p>Fondée en 1987 par le chef Henri Marceau, Boca s'est imposée comme une adresse incontournable de la scène gastronomique parisienne.</p>
				<p>Aujourd'hui, sa fille Camille perpétue la tradition familiale tout en insufflant un vent de modernité — sans jamais trahir l'essence de la maison : la sincérité du produit et le respect du geste.</p>
				<p>Notre brigade travaille en circuit court, en lien direct avec une vingtaine de producteurs français passionnés.</p>
			</div>
		</div>
		<img src="{{ asset('images/hero.jpg') }}" alt="Salle du restaurant" loading="lazy" class="aspect-[4/5] object-cover shadow-elegant"/>
	</section>

	<section class="bg-card/40 py-24 border-y border-border">
		<div class="container-prose grid md:grid-cols-3 gap-12 text-center">
			<div>
				<p class="font-serif text-6xl text-gold">35</p>
				<p class="mt-3 text-xs uppercase tracking-[0.25em] text-muted-foreground">Années d'expérience</p>
			</div>
			<div>
				<p class="font-serif text-6xl text-gold">20+</p>
				<p class="mt-3 text-xs uppercase tracking-[0.25em] text-muted-foreground">Producteurs partenaires</p>
			</div>
			<div>
				<p class="font-serif text-6xl text-gold">1</p>
				<p class="mt-3 text-xs uppercase tracking-[0.25em] text-muted-foreground">Étoile Michelin</p>
			</div>
		</div>
	</section>
{% endblock %}
